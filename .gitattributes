# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text diff=python
*.pyx text diff=python
*.pxd text diff=python

# Markdown and documentation
*.md text diff=markdown
*.rst text
*.yml text
*.yaml text
*.toml text

# Jupyter notebooks
*.ipynb text eol=lf

# Preserve byte-pinned external HTML response bodies exactly.
data/external/*.source.html binary

# Locator-pinned codebook artifacts are canonical UTF-8 JSON with LF bytes.
data/external/psid_codebook_field_evidence/*.json text eol=lf
data/external/psid_codebook_inventory_adjudication_v1.json text eol=lf
data/external/psid_questionnaire_dictionary_inventory_registration_required_v1.json text eol=lf
data/external/psid_modern_job_context_raw_extraction_specs_v1.json text eol=lf

# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Anchor snapshots: pinned bytes, never normalized
data/external/snapshots/** binary
data/external/snapshots/covered_earnings_methodology_capture1/** binary
