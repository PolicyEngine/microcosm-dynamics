st\"","pickleshare; extra == \"test\"","packaging; extra == \"test\"","ipython[test]; extra == \"test-extra\"","curio; extra == \"test-extra\"","jupyter_ai; extra == \"test-extra\"","matplotlib!=3.2.0; extra == \"test-extra\"","nbformat; extra == \"test-extra\"","numpy>=1.23; extra == \"test-extra\"","pandas; extra == \"test-extra\"","trio; extra == \"test-extra\"","matplotlib; extra == \"matplotlib\"","ipython[black,doc,kernel,matplotlib,nbconvert,nbformat,notebook,parallel,qtconsole]; extra == \"all\"","ipython[test,test_extra]; extra == \"all\""],"requires_python":">=3.10","summary":"IPython: Productive Interactive Computing","version":"8.39.0","yanked":false,"yanked_reason":null},"last_serial":40605594,"ownership":{"organization":"jupyter","roles":[{"role":"Owner","user":"bgranger"},{"role":"Owner","user":"fperez"},{"role":"Owner","user":"ivanov"},{"role":"Owner","user":"minrk"},{"role":"Owner","user":"takowl"},{"role":"Maintainer","user":"krassowski"},{"role":"Maintainer","user":"mbussonn"},{"role":"Maintainer","user":"trallard"}]},"urls":[{"comment_text":null,"core-metadata":{"sha256":"91f8aad15630af8a0972e7e1365d7b3ea2ea64147a80142b544c1874080cd3aa"},"digests":{"blake2b_256":"c0564cc7fc9e9e3f38fd324f24f8afe0ad8bb5fa41283f37f1aaf9de0612c968","md5":"fb55a3c5d50dea13205461f82fbaded6","sha256":"bb3c51c4fa8148ab1dea07a79584d1c854e234ea44aa1283bcb37bc75054651f"},"downloads":-1,"filename":"ipython-8.39.0-py3-none-any.whl","has_sig":false,"md5_digest":"fb55a3c5d50dea13205461f82fbaded6","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.10","size":831849,"upload_time":"2026-03-27T10:02:07","upload_time_iso_8601":"2026-03-27T10:02:07.846802Z","url":"https://files.pythonhosted.org/packages/c0/56/4cc7fc9e9e3f38fd324f24f8afe0ad8bb5fa41283f37f1aaf9de0612c968/ipython-8.39.0-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"4018f8598d287006885e7136451fdea0755af4ebcbfe342836f24dee